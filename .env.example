# Copy to .env (root is used by docker-compose; apps read their own .env files)

# --- Database (apps/api/.env) ---
DATABASE_URL="postgresql://pawconnect:pawconnect@localhost:5432/pawconnect?schema=public"

# --- API (apps/api/.env) ---
PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
# Optional: enables live Google Places enrichment of nearby results
GOOGLE_MAPS_API_KEY=""

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
