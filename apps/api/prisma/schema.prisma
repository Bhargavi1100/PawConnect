generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum PlaceType {
  VET_CLINIC
  VET_HOSPITAL
  SHELTER
}

enum PlaceSource {
  CURATED
  GOOGLE_PLACES
}

enum UserRole {
  USER
  ADMIN
}

model Place {
  id            String                                @id @default(uuid())
  type          PlaceType
  name          String
  // PostGIS geography point; queried via raw SQL (see src/routes/places.ts)
  location      Unsupported("geography(Point, 4326)")
  address       String
  phone         String?
  website       String?
  hours         Json?
  // IANA zone id (e.g. "Asia/Kolkata"); open-now is computed in this zone
  timezone      String?
  isEmergency   Boolean                               @default(false)
  is24Hours     Boolean                               @default(false)
  services      String[]                              @default([])
  googlePlaceId String?                               @unique
  verified      Boolean                               @default(false)
  source        PlaceSource                           @default(CURATED)
  createdAt     DateTime                              @default(now())
  updatedAt     DateTime                              @default(now()) @updatedAt

  @@index([location], type: Gist)
  @@index([type])
}

// Tracks which map "cells" (rounded lat/lng grid + place type) have already
// been enriched from Google Places, so repeat searches in the same area hit
// our database instead of Google's billing meter.
model EnrichmentArea {
  id         String   @id @default(uuid())
  cellKey    String   @unique
  enrichedAt DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
}
