{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace @pawconnect/api"
  },
  "deploy": {
    "startCommand": "npm run db:migrate --workspace @pawconnect/api && npm start --workspace @pawconnect/api",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
